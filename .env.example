# LLM provider: ollama (local / Sol) or openai (any OpenAI-compatible API, e.g. ASU RC)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Used when LLM_PROVIDER=openai. Key: Voyager portal > Keys. Model ids: GET $LLM_BASE_URL/models
LLM_BASE_URL=https://openai.rc.asu.edu/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_STRUCTURED_METHOD=json_schema   # or function_calling / json_mode if the default fails
# LLM_DISABLE_THINKING=1              # suppress <think> output on Qwen3-style models

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swm
POSTGRES_USER=swm
POSTGRES_PASSWORD=swm

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=swm-agents

# Pin the run used by 04/05 scripts, UI default and agents (default: best NMI run)
SWM_RUN_ID=
